      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "ties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tie"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "tuplets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tuplet"
      },
      "minItems": 0,
      "maxItems": 100000
