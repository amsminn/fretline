{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fretline.app/schema/score-v1.json",
  "title": "Fretline ScoreDocument V1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 65536
        },
        "subtitle": {
          "type": "string",
          "maxLength": 65536
        },
        "artist": {
          "type": "string",
          "maxLength": 65536
        },
        "album": {
          "type": "string",
          "maxLength": 65536
        },
        "words": {
          "type": "string",
          "maxLength": 65536
        },
        "music": {
          "type": "string",
          "maxLength": 65536
        },
        "copyright": {
          "type": "string",
          "maxLength": 65536
        },
        "instructions": {
          "type": "string",
          "maxLength": 65536
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "minItems": 0,
          "maxItems": 100000
