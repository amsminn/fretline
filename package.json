{
  "name": "fretline",
  "productName": "Fretline",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "description": "Offline score editor and practice desktop application",
  "author": "Fretline",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run build && electron .",
    "build": "vite build --mode main && vite build --mode preload && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:tokens": "bun script/qa/token-lint.ts",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "qa:bootstrap": "bun script/qa/bootstrap.ts",
    "qa:domain": "bun script/qa/domain.ts",
    "qa:electron": "bun script/qa/electron.ts",
    "qa:native": "bun script/qa/native.ts",
    "qa:audit": "bun script/qa/audit.ts",
    "package:mac": "bun run build && electron-builder --mac dir dmg --arm64"
  },
  "dependencies": {
    "@coderline/alphatab": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "signalsmith-stretch": "1.3.2",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@coderline/alphatab-vite": "1.9.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "pdfjs-dist": "6.5.438",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "trustedDependencies": ["electron"]
}
